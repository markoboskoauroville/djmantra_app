/* DJ Mantra skin. Generated by tools/skin/gen_djmantra_skin.py */
#Mixxx, WWidgetStack, #Landscape, #Portrait { background-color: #232325; }
WWidget, WLabel, QLabel { color: #f2f2f2; font-family: "Roboto", "Open Sans", sans-serif; }
#TopBar { background-color: #0d0d0f; padding: 6px 10px 4px 10px; }
#Centre, #Mixer { background-color: #1f1f22; }
#Centre { border-left: 1px solid #3a3a3e; border-right: 1px solid #3a3a3e; }
#Deck { background-color: #2b2b2e; padding: 6px; }
#TabRow { background-color: #1f1f22; padding: 4px; border-bottom: 1px solid #3a3a3e; }
#Transport { background-color: #2b2b2e; padding: 8px 10px; border-top: 1px solid #3a3a3e; }
#Selector { background-color: #2b2b2e; border-top: 1px solid #3a3a3e;
            border-bottom: 1px solid #3a3a3e; }
#WaveformArea { background-color: #000000; }
#LoopRow { background-color: #2e2e31; padding: 2px; }
#FullWaveforms { background-color: #000000; }

#ArtistText { color: #9a9aa0; font-size: 12px; }
#TitleText { color: #f2f2f2; font-size: 16px; }
#TimeText { color: #f2f2f2; font-size: 18px; }
#KeyDeck1 { color: #3ad13a; font-size: 13px; }
#KeyDeck2 { color: #e04ad0; font-size: 13px; }
#BpmText { color: #f2f2f2; font-size: 20px; }
#BpmCaption, #KnobLabel { color: #9a9aa0; font-size: 11px; text-transform: uppercase; }
#KnobLabel { qproperty-alignment: AlignCenter; }
#PadsTitle { color: #9a9aa0; font-size: 11px; }
#LoopSize { color: #f2f2f2; font-size: 14px; }

/* Text buttons: dark rounded rectangles */
WPushButton {
  color: #f2f2f2; background-color: #1b1b1d; border: 2px solid #4a4a4f;
  border-radius: 7px; font-size: 15px; font-weight: bold;
}
WPushButton[pressed="true"] { background-color: #3a3a3e; }
#SyncButton[displayValue="1"] { color: #0d0d0f; background-color: #2f8cff; border-color: #2f8cff; }
#CueSet[displayValue="1"] { border-color: #ffffff; }
#CuePair WPushButton { border-radius: 0px; }
#CueSet { border-top-left-radius: 8px; border-bottom-left-radius: 8px; border-right: 1px solid #4a4a4f; }
#CueReturn { border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-left: none; font-size: 20px; }
#RoundButton, #Chevron { border-radius: 20px; font-size: 18px; }
#Chevron { border-radius: 17px; background-color: #4a4a4f; border: none; }
#RoundButton[displayValue="1"] { border-color: #2f8cff; color: #2f8cff; }
#BendButton, #IconButton { background-color: transparent; border: none; color: #9a9aa0; font-size: 22px; }
#LoopButton { background-color: transparent; border: 2px solid #6a6a70; border-radius: 16px; font-size: 18px; }
#LoopButton[displayValue="1"] { border-color: #3ad13a; color: #3ad13a; }
#TabButton, #LibraryButton, #PlayButton { background-color: transparent; border: none; }
#SelectorButton { background-color: transparent; border: none; font-size: 24px; color: #f2f2f2; }
#SelectorButton[displayValue="1"] { color: #2f8cff; }
#BackButton, #LoadButton { font-size: 13px; }
#LoadButton { margin-left: 4px; }
WHotcueButton#Pad { background-color: #333336; border: 1px solid #4a4a4f; border-radius: 8px;
                    font-size: 15px; margin: 3px; }

/* Library */
#LibraryView, #LibraryTop { background-color: #0d0d0f; }
#LibraryTop { padding: 6px; }
WLibrary, WLibrarySidebar, QTableView, QTreeView {
  background-color: #232325; color: #f2f2f2; border: none; font-size: 15px;
  selection-background-color: #2f8cff; selection-color: #ffffff;
  alternate-background-color: #28282b;
}
QHeaderView::section { background-color: #2b2b2e; color: #9a9aa0; border: none; padding: 4px; }
WSearchLineEdit { background-color: #1b1b1d; color: #f2f2f2; border: 1px solid #4a4a4f;
                  border-radius: 8px; padding: 4px 8px; font-size: 15px; min-height: 28px; }
QScrollBar:vertical { background: #232325; width: 8px; }
QScrollBar::handle:vertical { background: #55555a; border-radius: 4px; min-height: 30px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0px; width: 0px; }
QMenu { background-color: #2b2b2e; color: #f2f2f2; border: 1px solid #4a4a4f; font-size: 15px; }
QMenu::item:selected { background-color: #2f8cff; }
QToolTip { background-color: #2b2b2e; color: #f2f2f2; border: 1px solid #4a4a4f; }
